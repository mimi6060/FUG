# APNs (Apple Push Notification service) Server Credentials
# =========================================================
#
# IMPORTANT: Ces credentials sont pour APPWRITE SERVEUR uniquement.
# L'app Flutter n'utilise PAS de SDK push Apple - elle utilise Appwrite SDK.
#
# Architecture:
#   Flutter App (Appwrite SDK) → Appwrite Messaging → APNs → iOS devices
#
# Appwrite Messaging a besoin des credentials APNs côté serveur pour
# router les notifications push vers les appareils iOS.
#
# Pour obtenir ces valeurs:
# 1. Apple Developer > Certificates, Identifiers & Profiles
# 2. Keys > Create a new key > Enable APNs
# 3. Télécharger le fichier .p8 et le placer dans ce dossier
# 4. Noter le Key ID affiché après création
# 5. Team ID est en haut à droite du portail Apple Developer
# 6. Bundle ID est l'identifiant de ton app (ex: com.fug.app)
#
# Note: Ces credentials restent sur le serveur Appwrite, jamais dans l'app Flutter.

APNS_KEY_ID=your_10_char_key_id
APNS_TEAM_ID=your_10_char_team_id
APNS_BUNDLE_ID=com.fug.app

# La clé auth sera chargée automatiquement depuis tout fichier .p8 dans ce dossier
# Ou tu peux la coller ici (inclure les lignes BEGIN/END):
# APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----
# your_key_content_here
# -----END PRIVATE KEY-----"
