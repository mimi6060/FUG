# APNs (Apple Push Notification service) Credentials
# Copy this file to .apns-credentials and fill in your values
#
# To get these values:
# 1. Go to Apple Developer > Certificates, Identifiers & Profiles
# 2. Create an APNs Auth Key (Keys > Create a new key > Enable APNs)
# 3. Download the .p8 file and place it in this directory
# 4. Note the Key ID shown after creation
# 5. Your Team ID is in the top-right of the Apple Developer portal
# 6. Bundle ID is your app's identifier (e.g., com.fug.app)

APNS_KEY_ID=your_10_char_key_id
APNS_TEAM_ID=your_10_char_team_id
APNS_BUNDLE_ID=com.fug.app

# The auth key will be loaded automatically from any .p8 file in this directory
# Or you can paste it here (include the BEGIN/END lines):
# APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----
# your_key_content_here
# -----END PRIVATE KEY-----"
