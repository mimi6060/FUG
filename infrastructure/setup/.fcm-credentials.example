# FCM (Firebase Cloud Messaging) Credentials
# Copy this file to .fcm-credentials and fill in your values
#
# To get these values:
# 1. Go to Firebase Console > Project Settings > Cloud Messaging
# 2. Copy the Server Key (Legacy server key)
#
# Note: Firebase is deprecating the legacy server key in favor of
# HTTP v1 API with service account. For now, Appwrite uses the legacy key.

FCM_SERVER_KEY=your_firebase_server_key_here
FCM_SENDER_ID=your_sender_id_here
