# =============================================================================
# FUG Project - Environment Variables
# =============================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement
# cp .env.example .env
# =============================================================================

# =============================================================================
# APPWRITE - Configuration Principale
# =============================================================================

# Environnement: development | production
_APP_ENV=development

# Localisation (fr, en, etc.)
_APP_LOCALE=fr

# Workers par CPU (ajuster selon les ressources)
_APP_WORKER_PER_CORE=6

# Protection contre les abus
_APP_OPTIONS_ABUSE=enabled

# Forcer HTTPS (activer en production)
_APP_OPTIONS_FORCE_HTTPS=disabled

# Cle OpenSSL - IMPORTANT: Generer une cle unique de 128+ bits
# Commande: openssl rand -hex 64
_APP_OPENSSL_KEY_V1=your-secret-key-min-128-bits-change-this-in-production

# =============================================================================
# DOMAINES
# =============================================================================

# Domaine principal Appwrite
_APP_DOMAIN=localhost

# Domaine cible (generalement identique au domaine principal)
_APP_DOMAIN_TARGET=localhost

# Domaine pour les fonctions Cloud
_APP_DOMAIN_FUNCTIONS=functions.localhost

# =============================================================================
# CONSOLE - Restrictions d'acces
# =============================================================================

# Autoriser l'inscription du premier utilisateur (root)
_APP_CONSOLE_WHITELIST_ROOT=enabled

# Emails autorises (vide = tous)
# Exemple: admin@example.com,dev@example.com
_APP_CONSOLE_WHITELIST_EMAILS=

# IPs autorisees (vide = toutes)
# Exemple: 192.168.1.1,10.0.0.1
_APP_CONSOLE_WHITELIST_IPS=

# =============================================================================
# REDIS - Cache et Queue
# =============================================================================

_APP_REDIS_HOST=redis
_APP_REDIS_PORT=6379
_APP_REDIS_USER=
_APP_REDIS_PASS=

# =============================================================================
# MARIADB - Base de donnees
# =============================================================================

_APP_DB_HOST=mariadb
_APP_DB_PORT=3306
_APP_DB_USER=appwrite
_APP_DB_PASS=password
_APP_DB_SCHEMA=appwrite

# Configuration MariaDB
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=appwrite
MYSQL_USER=appwrite
MYSQL_PASSWORD=password

# =============================================================================
# STOCKAGE
# =============================================================================

# Limite de taille de fichier (en octets) - 30MB par defaut
_APP_STORAGE_LIMIT=30000000

# Limite pour les previews d'images (en octets) - 20MB
_APP_STORAGE_PREVIEW_LIMIT=20000000

# Antivirus (ClamAV) - disabled | enabled
_APP_STORAGE_ANTIVIRUS=disabled

# Device de stockage: local | s3 | dospaces | backblaze | linode | wasabi
_APP_STORAGE_DEVICE=local

# Configuration S3 (si _APP_STORAGE_DEVICE=s3)
_APP_STORAGE_S3_ACCESS_KEY=
_APP_STORAGE_S3_SECRET=
_APP_STORAGE_S3_REGION=us-east-1
_APP_STORAGE_S3_BUCKET=

# =============================================================================
# FONCTIONS CLOUD
# =============================================================================

# Limite de taille du code (en octets) - 30MB
_APP_FUNCTIONS_SIZE_LIMIT=30000000

# Timeout d'execution (en secondes) - 15 minutes
_APP_FUNCTIONS_TIMEOUT=900

# Timeout de build (en secondes) - 15 minutes
_APP_FUNCTIONS_BUILD_TIMEOUT=900

# Limite CPU (0 = illimite)
_APP_FUNCTIONS_CPUS=0

# Limite memoire (0 = illimite)
_APP_FUNCTIONS_MEMORY=0

# Runtimes disponibles
_APP_FUNCTIONS_RUNTIMES=node-18.0,node-20.0,python-3.11,dart-3.0

# Seuil d'inactivite avant arret du container (secondes)
_APP_FUNCTIONS_INACTIVE_THRESHOLD=60

# Secret pour l'executor - IMPORTANT: Generer une cle unique
# Commande: openssl rand -hex 32
_APP_EXECUTOR_SECRET=your-256-bit-secret-change-this

# Version Appwrite
_APP_VERSION=latest

# =============================================================================
# SMTP - Configuration Email
# =============================================================================

# Serveur SMTP
_APP_SMTP_HOST=

# Port SMTP (25, 465, 587)
_APP_SMTP_PORT=

# Securite: empty | ssl | tls
_APP_SMTP_SECURE=

# Identifiants SMTP
_APP_SMTP_USERNAME=
_APP_SMTP_PASSWORD=

# =============================================================================
# GRAPHQL
# =============================================================================

# Taille max du batch
_APP_GRAPHQL_MAX_BATCH_SIZE=10

# Complexite max des requetes
_APP_GRAPHQL_MAX_COMPLEXITY=250

# Profondeur max des requetes
_APP_GRAPHQL_MAX_DEPTH=3

# =============================================================================
# MAINTENANCE
# =============================================================================

# Intervalle de maintenance (secondes) - 24h par defaut
_APP_MAINTENANCE_INTERVAL=86400

# Retention des executions (secondes) - 14 jours
_APP_MAINTENANCE_RETENTION_EXECUTION=1209600

# Retention du cache (secondes) - 30 jours
_APP_MAINTENANCE_RETENTION_CACHE=2592000

# Retention des logs d'abus (secondes) - 24h
_APP_MAINTENANCE_RETENTION_ABUSE=86400

# Retention des logs d'audit (secondes) - 14 jours
_APP_MAINTENANCE_RETENTION_AUDIT=1209600

# Retention des stats horaires (secondes) - 100 jours
_APP_MAINTENANCE_RETENTION_USAGE_HOURLY=8640000

# Retention des schedules (secondes) - 24h
_APP_MAINTENANCE_RETENTION_SCHEDULES=86400

# =============================================================================
# LOGGING (Optionnel)
# =============================================================================

# Provider: sentry | raygun | appSignal | logOwl
_APP_LOGGING_PROVIDER=

# Configuration du provider (JSON)
_APP_LOGGING_CONFIG=

# =============================================================================
# MONITORING - InfluxDB (Optionnel - profile: monitoring)
# =============================================================================

INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=fug
INFLUXDB_BUCKET=appwrite
INFLUXDB_TOKEN=your-super-secret-influxdb-token-change-this

# =============================================================================
# BACKUP
# =============================================================================

# Repertoire de backup
BACKUP_DIR=./backups

# Retention des backups (jours)
BACKUP_RETENTION_DAYS=7

# =============================================================================
# FUG FLUTTER APP
# =============================================================================

# Endpoint Appwrite pour l'application Flutter
APPWRITE_ENDPOINT=http://localhost/v1

# ID du projet Appwrite
APPWRITE_PROJECT_ID=fug

# Version de l'application
APP_VERSION=latest

# Port pour le developpement Flutter
FLUTTER_WEB_PORT=8080

# =============================================================================
# FUG FUNCTIONS
# =============================================================================

# Environnement Node.js
NODE_ENV=development
